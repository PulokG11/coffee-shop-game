# ── Client (Vite) ─────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://your-railway-app.railway.app

# ── Server (FastAPI / Railway) ────────────────────────────────────────────────
# Neon Postgres pooled connection string (copy from Neon dashboard → Connection string → Pooled)
DATABASE_URL=postgresql://neondb_owner:<password>@<pooler-host>/neondb?sslmode=require

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Neon project id (informational; not required at runtime)
NEON_PROJECT_ID=billowing-math-38092403

# Rate limiting (Upstash Redis free tier — optional)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# CORS origin for the deployed client
ALLOWED_ORIGINS=https://your-vercel-app.vercel.app
